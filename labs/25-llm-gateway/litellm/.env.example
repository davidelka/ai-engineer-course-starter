# Copy to .env (git-ignored) and fill, or run ./make_env.sh which writes random values.
# LiteLLM requires both keys to start with "sk-". Never change LITELLM_SALT_KEY after the
# first start: it encrypts credentials stored in the database.
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me-too
POSTGRES_PASSWORD=litellm
# Optional, only for the real-haiku model:
# ANTHROPIC_API_KEY=
