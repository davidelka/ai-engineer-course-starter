# Copy the lines you need into the repo's .env (git-ignored). Never commit values.
# ANTHROPIC_API_KEY=            # already in your .env from lesson 2
# EXTRACTOR=llm                 # default: heuristic (free)
# LLM_MODEL=anthropic:claude-haiku-5-5
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# AIRTABLE_TABLE=tblXXXXXXXXXXXXXX
# AIRTABLE_VIEW=New Jobs
# AIRTABLE_TOKEN=               # personal access token, scope data.records:read
# AIRTABLE_CSV=/path/to/New Jobs.csv   # instead of the API, for a view you cannot access by API
# WHATSAPP_DIR=/path/to/bridge/exports
# ADMIN_TOKEN=                  # enables PUT /preferences and POST /runs on the admin API
# GMAIL_ACCESS_TOKEN=           # OAuth token with scope gmail.compose, only for DRAFTS=gmail
