# Copy the lines you need into the repo's .env (git-ignored). Never commit values.
# ANTHROPIC_API_KEY=            # already in your .env from lesson 2 (needed only for MODE=live)
# MODE=offline                  # offline (default, free) | mock (mockllm over HTTP, free) | live (Haiku + e5-small)
# EMBEDDER=e5-small             # default: fake offline, e5-small live
# LLM_MODEL=anthropic:claude-haiku-5-5
# JUDGE_MODEL=anthropic:claude-haiku-5-5
# RERANK=                       # empty (off) | fake | ce:bge-m3 (2.3 GB download) | llm:anthropic:claude-haiku-5-5
# VERSION_MODE=retrieved        # retrieved | corpus | recent | off
# TOP_K=6                       # max chunks in the prompt
# TRACE_FILE=results/traces.jsonl
